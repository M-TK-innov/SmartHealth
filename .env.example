# --- IA (extraction clinique, synthese, ordonnance) ---
# Sans cle, l'application bascule automatiquement sur le moteur d'extraction
# deterministe local (regles + lexique medical FR/EN) : 100% hors-ligne.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Base de donnees (SQLite local, souverainete des donnees) ---
SMARTHEALTH_DB=./data/smarthealth.db

# --- Etablissement ---
FACILITY_NAME=Centre de Sante de Cotonou
FACILITY_ID=BJ-LIT-CSC-001
FACILITY_COUNTRY=BJ

# --- Interoperabilite ---
# Les ADRESSES se reglent desormais dans Administration > Reseau et serveurs,
# ou elles sont confrontees aux restrictions sanitaires avant enregistrement.
# Les variables ci-dessous restent lues comme valeurs de repli, et surtout
# portent les SECRETS : un secret modifiable depuis une page web est un secret
# expose, il ne descend jamais dans la base de configuration.
FHIR_BASE_URL=http://localhost:3000/api/fhir
# Jeton attendu sur l'API FHIR quand l'acces est regle sur « jeton de service ».
# Valeur aleatoire d'au moins 32 caracteres, propre a chaque installation.
FHIR_API_TOKEN=
# Cible d'export automatique (OpenMRS, HAPI FHIR, DHIS2...) - optionnel
FHIR_EXPORT_ENDPOINT=
FHIR_EXPORT_TOKEN=
DHIS2_BASE_URL=
DHIS2_TOKEN=

# --- Transcription Whisper (optionnel) ---
# Serveur whisper.cpp ou faster-whisper de l etablissement.
# Sans cette variable, seuls les moteurs navigateur et sur-appareil sont proposes.
WHISPER_ENDPOINT=
WHISPER_TOKEN=

# --- Transcription Griot : consultation en fon (optionnel) ---
# Service portant le modele ouvert Griot, entraine sur les langues africaines.
# Il rend du TEXTE FON a partir d une consultation tenue en fon : il ne traduit
# pas. La mise en francais medical se fait plus loin, a l extraction clinique.
# Aucun des trois autres moteurs ne sait ecouter le fon.
#
# LAISSEZ CETTE VARIABLE VIDE dans le cas courant : l application lance le
# service avec elle (scripts/services.mjs) et renseigne l adresse elle-meme.
# Ne la remplissez que pour pointer un service deja en place sur une AUTRE
# machine. Le service demande PyTorch, donc il ne tourne pas dans le navigateur
# et reste sur le reseau de la structure.
#
# Comme Whisper, il recoit de l audio brut de consultation : meme classe de
# donnee, memes restrictions sanitaires, meme categorie reseau.
GRIOT_ENDPOINT=
GRIOT_TOKEN=

# --- Traduction fon -> francais (optionnel, second etage du meme service) ---
# Se regle dans l environnement du SERVICE (services/griot), pas ici : c est lui
# qui charge le modele. Rappel pour memoire, voir services/griot/README.md.
#
#   TRADUCTION_MODELE=masakhane/m2m100_418M_fon_fr_rel_news
#
# Vide = pas de traduction, le texte fon repart tel quel. Aucun modele fon ->
# francais leger n est aujourd hui a la fois evalue sur des consultations et
# clairement licencie pour le soin : le choix engage la structure.
# La phrase en fon est toujours conservee a cote de sa traduction.
