# --- IA (extraction clinique, synthese, ordonnance) ---
# Sans cle, l'application bascule automatiquement sur le moteur d'extraction
# deterministe local (regles + lexique medical FR/EN) : 100% hors-ligne.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Base de donnees (SQLite local, souverainete des donnees) ---
PARLEDOCTEUR_DB=./data/parledocteur.db

# --- Etablissement ---
FACILITY_NAME=Centre de Sante de Cotonou
FACILITY_ID=BJ-LIT-CSC-001
FACILITY_COUNTRY=BJ

# --- Interoperabilite ---
# Les ADRESSES se reglent desormais dans Administration > Reseau et serveurs,
# ou elles sont confrontees aux restrictions sanitaires avant enregistrement.
# Les variables ci-dessous restent lues comme valeurs de repli, et surtout
# portent les SECRETS : un secret modifiable depuis une page web est un secret
# expose, il ne descend jamais dans la base de configuration.
FHIR_BASE_URL=http://localhost:3000/api/fhir
# Jeton attendu sur l'API FHIR quand l'acces est regle sur « jeton de service ».
# Valeur aleatoire d'au moins 32 caracteres, propre a chaque installation.
FHIR_API_TOKEN=
# Cible d'export automatique (OpenMRS, HAPI FHIR, DHIS2...) - optionnel
FHIR_EXPORT_ENDPOINT=
FHIR_EXPORT_TOKEN=
DHIS2_BASE_URL=
DHIS2_TOKEN=

# --- Transcription Whisper (optionnel) ---
# Serveur whisper.cpp ou faster-whisper de l etablissement.
# Sans cette variable, seuls les moteurs navigateur et sur-appareil sont proposes.
WHISPER_ENDPOINT=
WHISPER_TOKEN=
