node_modules/
.next/
# Sorties de construction paralleles (NEXT_DIST_DIR), pour ne pas marcher
# sur le .next d un serveur de developpement deja en cours.
.next-*/
out/
# Donnees de sante : tout le dossier, sous-repertoires compris (les sauvegardes
# produites depuis la console d administration atterrissent dans data/sauvegardes/).
data/**/*.db
data/**/*.db-*
data/*.db
data/*.db-*
data/sauvegardes/
data/audio/
.env
.env.local
.tmp/
*.tsbuildinfo
next-env.d.ts

# Sorties de construction desktop
dist-desktop/
dist-desktop2/

# Icones generees par scripts/gen-icons.mjs : reproductibles, hors depot
public/icons/
electron/icon.png
electron/icon.ico

# Supports de la communication BWAI 2026 : a trancher, hors du depot pour l instant.
docs/bwai-2026/

# Caches Python des services auxiliaires
__pycache__/
*.py[cod]
.venv/

# Poids des modeles : 240 Mo de binaires, recuperes par « npm run modeles ».
public/modeles/
.claude/

# Saveur du paquet desktop, ecrite a chaque preparation. Absente,
# electron/main.js retient la version COMPLETE : le defaut sur.
electron/saveur.json
