{
  "name": "smarthealth",
  "version": "0.2.0",
  "private": true,
  "description": "Scribe medical IA multiplateforme - synthese de consultation, dossier medical, ordonnance numerique, interoperabilite FHIR R4 / HL7 v2 / DHIS2",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/lancer.mjs",
    "predev": "node scripts/gen-icons.mjs",
    "build": "next build",
    "prebuild": "node scripts/gen-icons.mjs",
    "start": "node scripts/lancer.mjs --prod",
    "test": "node --test tests/*.test.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "desktop:dev": "node scripts/lancer.mjs --desktop",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "npm run desktop:prepare && electron-builder --win --publish never",
    "desktop:dir": "npm run desktop:prepare && electron-builder --win --dir --publish never",
    "services": "node scripts/services.mjs --autonome",
    "start:next": "next start -p 3000",
    "dev:next": "next dev -p 3000",
    "mesure": "node scripts/mesurer.mjs",
    "modeles": "node scripts/modeles.mjs",
    "demo:dump": "node scripts/demo-dump.mjs",
    "verifier:vercel": "python scripts/valider-vercel.py",
    "demo:dev": "node scripts/demo.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "@huggingface/transformers": "^4.2.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "bj.semecity.smarthealth",
    "productName": "SmartHealth",
    "copyright": "SmartHealth",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      "scripts/services.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app/node_modules"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "artifactName": "SmartHealth-${version}-installateur.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SmartHealth",
      "installerLanguages": [
        "fr_FR"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "electron/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.medical",
      "icon": "electron/icon.png"
    }
  }
}
